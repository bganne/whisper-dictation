# whisper-dictation configuration
# Copied to ~/.config/whisper-dictation/whisper-dictation.conf on first install.
# Re-running install.sh will NOT overwrite this file.
#
# Priority for all settings: environment variable > this file > built-in default.

# ── Model ─────────────────────────────────────────────────────────────────────

# Whisper model to use. See README.md for the speed/accuracy trade-off table.
# Options: tiny.en  base.en  small.en  medium.en  large-v3
WHISPER_MODEL="medium.en"

# Language code for transcription (empty string = auto-detect).
WHISPER_LANGUAGE="en"

# ── Keybinding ────────────────────────────────────────────────────────────────

# Key registered as the GNOME custom keybinding (xkb key name).
GNOME_KEYBINDING="F12"

# ── Whisper-stream ────────────────────────────────────────────────────────────

# Number of threads for whisper.cpp inference.
THREADS=4

# Audio buffer length in ms (how much audio whisper-stream holds).
STREAM_LENGTH=10000

# VAD sensitivity threshold (0.0–1.0, lower = more sensitive).
VAD_THRESHOLD=0.6

# High-pass frequency threshold in Hz (filters low-frequency noise).
FREQ_THRESHOLD=100.0

# Extra arguments passed directly to whisper-stream (advanced).
EXTRA_STREAM_ARGS=""

# ── On-Screen Display (OSD) ───────────────────────────────────────────────────

# osd_cat font (X11 font string).
OSD_FONT="-adobe-helvetica-bold-r-normal--36-0-0-0-p-0-iso8859-1"

# OSD text colour (X11 colour name or #RRGGBB).
OSD_COLOR="red"

# OSD text outline thickness in pixels.
OSD_OUTLINE=2

# OSD vertical position: top | middle | bottom
OSD_POS="bottom"

# OSD horizontal alignment: left | center | right
OSD_ALIGN="right"

# OSD offset from the screen edge in pixels.
OSD_OFFSET=20

#!/usr/bin/env bash
set -euo pipefail

# ── Config ─────────────────────────────────────────────────────────────────────

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/whisper-dictation/whisper-dictation.conf"
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

WHISPER_MODEL="${WHISPER_MODEL:-medium.en}"
export WHISPER_MODEL

INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/whisper-dictation"

# ── Paths ──────────────────────────────────────────────────────────────────────

SOCKET="/tmp/whisper-dictation-$(id -u).sock"
STATEFILE="/tmp/whisper-dictation-$(id -u).state"
LOCKFILE="/tmp/whisper-dictation-$(id -u).lock"

# ── Toggle logic ───────────────────────────────────────────────────────────────

if [ ! -S "$SOCKET" ]; then
    # Daemon not running — start it (prevent double spawn with a lock file)
    [ -f "$LOCKFILE" ] && exit 0
    touch "$LOCKFILE"
    "$INSTALL_DIR/venv/bin/python3" "$INSTALL_DIR/whisper-daemon.py" &
    for i in $(seq 30); do
        [ -S "$SOCKET" ] && break
        sleep 1
    done
    rm -f "$LOCKFILE"
    echo "on" > "$STATEFILE"
elif [ -f "$STATEFILE" ] && [ "$(cat "$STATEFILE")" = "on" ]; then
    echo "stop" | socat - UNIX-CONNECT:"$SOCKET"
    echo "off" > "$STATEFILE"
else
    echo "start" | socat - UNIX-CONNECT:"$SOCKET"
    echo "on" > "$STATEFILE"
fi

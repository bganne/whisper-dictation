#!/usr/bin/env bash
set -euo pipefail

# ── oneAPI runtime (SYCL builds need this) ─────────────────────────────────────

if [ -f /opt/intel/oneapi/setvars.sh ]; then
    set +euo pipefail
    source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1
    set -euo pipefail
fi

# ── Config ─────────────────────────────────────────────────────────────────────

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/whisper-dictation/whisper-dictation.conf"
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/whisper-dictation"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

WHISPER_MODEL="${WHISPER_MODEL:-medium.en}"
WHISPER_LANGUAGES="${WHISPER_LANGUAGES:-en}"
THREADS="${THREADS:-8}"
STREAM_LENGTH="${STREAM_LENGTH:-10000}"
VAD_THRESHOLD="${VAD_THRESHOLD:-0.6}"
FREQ_THRESHOLD="${FREQ_THRESHOLD:-100.0}"
EXTRA_STREAM_ARGS="${EXTRA_STREAM_ARGS:-}"

OSD_FONT="${OSD_FONT:--adobe-helvetica-bold-r-normal--36-0-0-0-p-0-iso8859-1}"
OSD_COLOR="${OSD_COLOR:-red}"
OSD_OUTLINE="${OSD_OUTLINE:-2}"
OSD_POS="${OSD_POS:-bottom}"
OSD_ALIGN="${OSD_ALIGN:-right}"
OSD_OFFSET="${OSD_OFFSET:-20}"

# ── Paths ──────────────────────────────────────────────────────────────────────

SOCKET="$RUNTIME_DIR/whisper-dictation-$(id -u).sock"
FIFO="$RUNTIME_DIR/whisper-dictation-$(id -u).fifo"
MODEL_PATH="$INSTALL_DIR/models/ggml-${WHISPER_MODEL}.bin"
STREAM_BIN="$INSTALL_DIR/build/bin/stream"

# ── State ──────────────────────────────────────────────────────────────────────

STREAM_PID=""
READER_PID=""
OSD_PID=""

# Language cycle: -1 = off, 0..N = index into LANG_LIST
read -ra LANG_LIST <<< "$WHISPER_LANGUAGES"
LANG_INDEX=-1
ACTIVE_LANGUAGE="${LANG_LIST[0]}"

# Backend is detected once on first start and cached
BACKEND=""

# ── OSD ────────────────────────────────────────────────────────────────────────

osd() {
    local msg="${1:-}"
    local persistent="${2:-false}"

    [ -n "$OSD_PID" ] && kill "$OSD_PID" 2>/dev/null && wait "$OSD_PID" 2>/dev/null || true
    OSD_PID=""

    [ -z "$msg" ] && return

    local delay=1
    [ "$persistent" = "true" ] && delay=-1

    echo "$msg" | osd_cat \
        --pos="$OSD_POS" --align="$OSD_ALIGN" --offset="$OSD_OFFSET" \
        --font="$OSD_FONT" --colour="$OSD_COLOR" --outline="$OSD_OUTLINE" \
        --delay="$delay" &
    local pid=$!

    [ "$persistent" = "true" ] && OSD_PID=$pid
}

# ── Parse stream output and type ───────────────────────────────────────

# Known whisper hallucinations on silence/noise — block these exactly
_is_hallucination() {
    local t="${1,,}"
    t="${t%.}"   # strip trailing period for normalisation
    case "$t" in
        "thank you"|"thanks for watching"|"thanks for watching!"|"you"|"bye"|\
        "bye!"|"goodbye"|"please subscribe"|"subscribe"|"like and subscribe"|\
        "see you next time"|"see you in the next video"|"subtitles by"|\
        "subtitled by"|"transcribed by"|"captions by"|"ご視聴ありがとうございました"|\
        "") return 0 ;;
    esac
    return 1
}

parse_and_type() {
    local text=""
    local in_block=false
    local -a typed_history=()
    local HISTORY_LIMIT=150

    while IFS= read -r line; do
        if [[ "$line" == "### Transcription "* ]]; then
            if [[ "$line" == *" START "* ]]; then
                in_block=true
                text=""
            elif [[ "$line" == *" END" ]]; then
                in_block=false
                text="${text#"${text%%[![:space:]]*}"}"
                text="${text%"${text##*[![:space:]]}"}"

                if [ -n "$text" ]; then
                    local -a new_words
                    read -ra new_words <<< "$text"

                    # Skip single-word blocks (almost always noise artifacts)
                    [ ${#new_words[@]} -lt 2 ] && { text=""; continue; }

                    # Skip known whisper hallucinations
                    _is_hallucination "$text" && { text=""; continue; }

                    if [ ${#typed_history[@]} -eq 0 ]; then
                        # First block: type everything
                        xdotool type --clearmodifiers --delay 0 -- "$text"
                        typed_history=("${new_words[@]}")
                    else
                        # Find longest overlap: suffix of history matching prefix of new block
                        local typed_len=${#typed_history[@]}
                        local new_len=${#new_words[@]}
                        local max_k=$(( typed_len < new_len ? typed_len : new_len ))
                        local overlap=0
                        local k j match typed_norm new_norm
                        for (( k = max_k; k >= 3; k-- )); do
                            match=true
                            for (( j = 0; j < k; j++ )); do
                                typed_norm="${typed_history[typed_len - k + j],,}"
                                typed_norm="${typed_norm//[^abcdefghijklmnopqrstuvwxyz0-9]/}"
                                new_norm="${new_words[j],,}"
                                new_norm="${new_norm//[^abcdefghijklmnopqrstuvwxyz0-9]/}"
                                if [[ "$typed_norm" != "$new_norm" ]]; then
                                    match=false
                                    break
                                fi
                            done
                            if $match; then
                                overlap=$k
                                break
                            fi
                        done

                        if [ "$overlap" -ge 3 ]; then
                            # Type only the novel suffix
                            local -a novel_words=("${new_words[@]:$overlap}")
                            if [ ${#novel_words[@]} -gt 0 ]; then
                                xdotool type --clearmodifiers --delay 0 -- " ${novel_words[*]}"
                                typed_history+=("${novel_words[@]}")
                            fi
                            # else: entire block already typed, skip
                        else
                            # No significant overlap — new sentence or after silence
                            xdotool type --clearmodifiers --delay 0 -- " ${text}"
                            typed_history+=("${new_words[@]}")
                        fi

                        # Trim history to bounded size
                        if [ ${#typed_history[@]} -gt $HISTORY_LIMIT ]; then
                            typed_history=("${typed_history[@]: -$HISTORY_LIMIT}")
                        fi
                    fi
                fi

                text=""
            fi
            continue
        fi

        if $in_block; then
            # Strip all bracketed tokens: timestamps, [BLANK_AUDIO], (Silence), …
            line=$(sed -E 's/\[[^]]*\]|\([^)]*\)|\*[^*]*\*//g; s/^[[:space:]]*//' <<< "$line")
            [ -n "$line" ] || continue
            [ -n "$text" ] && text="$text "
            text="${text}${line}"
        fi
    done < "$FIFO"
}

# ── Recording control ──────────────────────────────────────────────────────────

do_start() {
    [ -n "$STREAM_PID" ] && return

    rm -f "$FIFO"
    mkfifo "$FIFO"

    local -a lang_args=()
    [ -n "$ACTIVE_LANGUAGE" ] && lang_args=(--language "$ACTIVE_LANGUAGE")

    local -a extra_args=()
    [ -n "$EXTRA_STREAM_ARGS" ] && read -ra extra_args <<< "$EXTRA_STREAM_ARGS"

    local stderr_log="$RUNTIME_DIR/whisper-dictation-$(id -u).stderr"
    local lang_label="${ACTIVE_LANGUAGE^^}"

    # Show loading OSD — use cached backend or fixed-width placeholder
    osd "loading [$lang_label] [${BACKEND:-------}]" true

    "$STREAM_BIN" \
        --model "$MODEL_PATH" \
        --step 0 \
        --threads "$THREADS" \
        --length "$STREAM_LENGTH" \
        --vad-thold "$VAD_THRESHOLD" \
        --freq-thold "$FREQ_THRESHOLD" \
        --no-fallback \
        "${lang_args[@]}" \
        "${extra_args[@]}" \
        > "$FIFO" 2>"$stderr_log" &
    STREAM_PID=$!

    parse_and_type &
    READER_PID=$!

    # Detect backend once, then cache it for future loading screens
    if [ -z "$BACKEND" ]; then
        local backend="unknown"
        for _ in $(seq 100); do
            kill -0 "$STREAM_PID" 2>/dev/null || break
            if grep -qi "sycl" "$stderr_log" 2>/dev/null; then
                backend="SYCL"; break
            elif grep -qi "vulkan" "$stderr_log" 2>/dev/null; then
                backend="Vulkan"; break
            elif grep -qi "cpu" "$stderr_log" 2>/dev/null; then
                backend="CPU"; break
            fi
            sleep 0.1
        done
        # Pad to width of longest backend ("unknown" = 7) so brackets stay fixed
        BACKEND=$(printf '%-7s' "$backend")
        osd "loading [$lang_label] [$BACKEND]" true
        sleep 1
    fi

    osd "* REC * [$lang_label]" true
}

do_stop() {
    [ -z "$STREAM_PID" ] && return

    kill "$STREAM_PID" 2>/dev/null && wait "$STREAM_PID" 2>/dev/null || true
    STREAM_PID=""

    # Reader exits naturally when the FIFO write-end closes (stream EOF).
    # Give it up to 0.5 s to finish any in-progress xdotool type before force-killing.
    local i
    for i in 1 2 3 4 5; do
        kill -0 "$READER_PID" 2>/dev/null || break
        sleep 0.1
    done
    kill "$READER_PID" 2>/dev/null && wait "$READER_PID" 2>/dev/null || true
    READER_PID=""

    rm -f "$FIFO"
    osd ""
}

# ── Language commands ──────────────────────────────────────────────────────────

# lang <code>: switch to a specific language, restarting stream if running
do_lang() {
    local code="$1"
    [ -z "$code" ] && return
    local was_running=false
    [ -n "$STREAM_PID" ] && was_running=true
    do_stop
    ACTIVE_LANGUAGE="$code"
    # Keep LANG_INDEX in sync if the language is in the cycle list
    local i
    for i in "${!LANG_LIST[@]}"; do
        if [ "${LANG_LIST[$i]}" = "$code" ]; then
            LANG_INDEX=$i
            break
        fi
    done
    $was_running && do_start
}

# cycle: off → lang[0] → lang[1] → … → lang[N] → off → …
do_cycle() {
    local next=$(( LANG_INDEX + 1 ))
    if [ "$next" -ge "${#LANG_LIST[@]}" ]; then
        do_stop
        LANG_INDEX=-1
    else
        LANG_INDEX=$next
        ACTIVE_LANGUAGE="${LANG_LIST[$LANG_INDEX]}"
        do_stop
        do_start
    fi
}

# ── Cleanup ────────────────────────────────────────────────────────────────────

cleanup() {
    do_stop
    rm -f "$SOCKET" "$FIFO"
    exit 0
}

trap cleanup SIGTERM SIGINT

# ── Model loading indicator ───────────────────────────────────────────────────

echo "whisper-daemon starting, model=$WHISPER_MODEL languages=$WHISPER_LANGUAGES" >&2

# ── Socket server ──────────────────────────────────────────────────────────────

rm -f "$SOCKET"

# Start recording immediately — daemon is launched on first keypress
LANG_INDEX=0
ACTIVE_LANGUAGE="${LANG_LIST[0]}"
do_start

while true; do
    cmd=$(socat -T5 UNIX-LISTEN:"$SOCKET",mode=0600 STDOUT 2>/dev/null) || continue
    # Strip trailing newline, then trim leading/trailing whitespace
    cmd="${cmd%%$'\n'*}"
    cmd="${cmd#"${cmd%%[![:space:]]*}"}"
    cmd="${cmd%"${cmd##*[![:space:]]}"}"
    case "$cmd" in
        start)     do_start ;;
        stop)      do_stop  ;;
        cycle)     do_cycle ;;
        "lang "*)  do_lang "${cmd#lang }" ;;
    esac
done

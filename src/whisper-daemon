#!/usr/bin/env bash
set -euo pipefail

# ── Config ─────────────────────────────────────────────────────────────────────

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/whisper-dictation/whisper-dictation.conf"
# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/whisper-dictation"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"

WHISPER_MODEL="${WHISPER_MODEL:-large-v3-turbo-q5_0}"
WHISPER_LANGUAGES="${WHISPER_LANGUAGES:-en}"
_default_threads=$(( $(nproc) / 2 ))
[ "$_default_threads" -lt 2 ] && _default_threads=2
THREADS="${THREADS:-$_default_threads}"
STREAM_LENGTH="${STREAM_LENGTH:-10000}"
VAD_THRESHOLD="${VAD_THRESHOLD:-0.6}"
FREQ_THRESHOLD="${FREQ_THRESHOLD:-100.0}"
EXTRA_STREAM_ARGS="${EXTRA_STREAM_ARGS:-}"

OSD_FONT="${OSD_FONT:--adobe-helvetica-bold-r-normal--36-0-0-0-p-0-iso8859-1}"
OSD_COLOR="${OSD_COLOR:-red}"
OSD_OUTLINE="${OSD_OUTLINE:-2}"
OSD_POS="${OSD_POS:-bottom}"
OSD_ALIGN="${OSD_ALIGN:-right}"
OSD_OFFSET="${OSD_OFFSET:-20}"

# ── Paths ──────────────────────────────────────────────────────────────────────

SOCKET="$RUNTIME_DIR/whisper-dictation-$(id -u).sock"
FIFO="$RUNTIME_DIR/whisper-dictation-$(id -u).fifo"
MODEL_PATH="$INSTALL_DIR/models/ggml-${WHISPER_MODEL}.bin"
STREAM_BIN="$INSTALL_DIR/build/bin/whisper-stream"

# ── State ──────────────────────────────────────────────────────────────────────

STREAM_PID=""
READER_PID=""
OSD_PID=""

# Language cycle: -1 = off, 0..N = index into LANG_LIST
read -ra LANG_LIST <<< "$WHISPER_LANGUAGES"
LANG_INDEX=-1
ACTIVE_LANGUAGE="${LANG_LIST[0]}"

# Backend is detected once on first start and cached
BACKEND=""

# ── OSD ────────────────────────────────────────────────────────────────────────

osd() {
    local msg="${1:-}"
    local persistent="${2:-false}"

    if [ -n "$OSD_PID" ]; then
        kill "$OSD_PID" 2>/dev/null || true
        wait "$OSD_PID" 2>/dev/null || true
    fi
    OSD_PID=""

    [ -z "$msg" ] && return

    local delay=1
    [ "$persistent" = "true" ] && delay=-1

    echo "$msg" | osd_cat \
        --pos="$OSD_POS" --align="$OSD_ALIGN" --offset="$OSD_OFFSET" \
        --font="$OSD_FONT" --colour="$OSD_COLOR" --outline="$OSD_OUTLINE" \
        --delay="$delay" &
    local pid=$!

    [ "$persistent" = "true" ] && OSD_PID=$pid
}

# ── Parse stream output and type ───────────────────────────────────────

# Known whisper hallucinations on silence/noise — block exact and pattern matches
_is_hallucination() {
    local t="${1,,}"
    t="${t%[.!?]}"    # strip trailing punctuation
    t="${t#"${t%%[![:space:]]*}"}"   # trim leading whitespace
    t="${t%"${t##*[![:space:]]}"}"   # trim trailing whitespace
    [[ -z "$t" || "$t" == "you" ]] && return 0
    case "$t" in
        "bye"|"bye!"|"goodbye"|"good bye") return 0 ;;
        "subscribe"|"please subscribe"|"like and subscribe") return 0 ;;
        "ご視聴ありがとうございました") return 0 ;;
    esac
    [[ "$t" =~ ^thank(s|\ you)(\ (for|very).*)? ]] && return 0
    [[ "$t" =~ ^see\ you(\ (next\ time|in\ the\ next(\ video)?))?$ ]] && return 0
    [[ "$t" =~ ^(subtitl(ed|es)|transcribed|captions)\ by ]] && return 0
    return 1
}

# Remove intra-block phrase repetitions produced by whisper re-stating a partial phrase.
# Example: "do you see better Do you see better models" → "do you see better models"
# Accepts word array as positional args; echoes deduplicated words on stdout.
_dedup_intra() {
    local -a words=("$@")
    local n=${#words[@]}
    [ "$n" -lt 6 ] && { echo "${words[*]}"; return; }
    local max_k i j k m w1 w2 match
    for (( i = 0; i <= n - 6; i++ )); do
        max_k=$(( n - i < 10 ? n - i : 10 ))
        for (( k = max_k; k >= 3; k-- )); do
            for (( j = i + k; j + k <= n; j++ )); do
                match=true
                for (( m = 0; m < k; m++ )); do
                    w1="${words[i+m],,}"; w1="${w1//[^a-z0-9]/}"
                    w2="${words[j+m],,}"; w2="${w2//[^a-z0-9]/}"
                    [[ "$w1" == "$w2" ]] || { match=false; break; }
                done
                if $match; then
                    local -a result=()
                    [ "$i" -gt 0 ] && result+=("${words[@]:0:$i}")
                    result+=("${words[@]:$j}")
                    echo "${result[*]}"
                    return
                fi
            done
        done
    done
    echo "${words[*]}"
}

parse_and_type() {
    local text=""
    local in_block=false
    local -a typed_history=()
    local HISTORY_LIMIT=150

    while IFS= read -r line; do
        if [[ "$line" == "### Transcription "* ]]; then
            if [[ "$line" == *" START "* ]]; then
                in_block=true
                text=""
            elif [[ "$line" == *" END" ]]; then
                in_block=false
                text="${text#"${text%%[![:space:]]*}"}"
                text="${text%"${text##*[![:space:]]}"}"

                if [ -n "$text" ]; then
                    local -a new_words
                    # Replace hyphens with spaces before splitting so "rendez-vous"
                    # and "rendez vous" produce the same tokens for dedup matching.
                    read -ra new_words <<< "${text//-/ }"

                    # Remove intra-block repetitions (whisper re-stating a partial phrase)
                    read -ra new_words < <(_dedup_intra "${new_words[@]}")
                    text="${new_words[*]}"

                    # Skip single-word blocks (almost always noise artifacts)
                    [ ${#new_words[@]} -lt 2 ] && { text=""; continue; }

                    # Skip known whisper hallucinations
                    _is_hallucination "$text" && { text=""; continue; }

                    if [ ${#typed_history[@]} -eq 0 ]; then
                        # First block: type everything
                        xdotool type --clearmodifiers --delay 0 -- "${new_words[*]}"
                        typed_history=("${new_words[@]}")
                    else
                        # Find longest overlap: suffix of history matching prefix of new block
                        local typed_len=${#typed_history[@]}
                        local new_len=${#new_words[@]}
                        local max_k=$(( typed_len < new_len ? typed_len : new_len ))
                        local overlap=0
                        local k j match typed_norm new_norm
                        for (( k = max_k; k >= 3; k-- )); do
                            match=true
                            for (( j = 0; j < k; j++ )); do
                                typed_norm="${typed_history[typed_len - k + j],,}"
                                typed_norm="${typed_norm//[^abcdefghijklmnopqrstuvwxyz0-9]/}"
                                new_norm="${new_words[j],,}"
                                new_norm="${new_norm//[^abcdefghijklmnopqrstuvwxyz0-9]/}"
                                if [[ "$typed_norm" != "$new_norm" ]]; then
                                    match=false
                                    break
                                fi
                            done
                            if $match; then
                                overlap=$k
                                break
                            fi
                        done

                        if [ "$overlap" -ge 3 ]; then
                            # Type only the novel suffix
                            local -a novel_words=("${new_words[@]:$overlap}")
                            if [ ${#novel_words[@]} -gt 0 ]; then
                                xdotool type --clearmodifiers --delay 0 -- " ${novel_words[*]}"
                                typed_history+=("${novel_words[@]}")
                            fi
                            # else: entire block already typed, skip
                        else
                            # No significant overlap — new sentence or after silence
                            xdotool type --clearmodifiers --delay 0 -- " ${new_words[*]}"
                            typed_history+=("${new_words[@]}")
                        fi

                        # Trim history to bounded size
                        if [ ${#typed_history[@]} -gt $HISTORY_LIMIT ]; then
                            typed_history=("${typed_history[@]: -$HISTORY_LIMIT}")
                        fi
                    fi
                fi

                text=""
            fi
            continue
        fi

        if $in_block; then
            [ -n "$line" ] || continue
            [ -n "$text" ] && text="$text "
            text="${text}${line}"
        fi
    done < <(stdbuf -oL sed -E 's/\x1b\[[0-9;]*[A-Za-z]//g; s/[[:cntrl:]]//g; s/\[[^]]*\]|\([^)]*\)|\*[^*]*\*//g; s/[\[\]()]//g; s/^[[:space:]]*//' "$FIFO")
}

# ── Recording control ──────────────────────────────────────────────────────────

do_start() {
    [ -n "$STREAM_PID" ] && return

    # Validate model file exists before launching
    if [ ! -f "$MODEL_PATH" ] || [ ! -s "$MODEL_PATH" ]; then
        osd "ERROR: model not found" false
        echo "ERROR: Model file not found or empty: $MODEL_PATH" >&2
        echo "Run ./install.sh to download the model." >&2
        return 1
    fi

    rm -f "$FIFO"
    mkfifo "$FIFO"

    local -a lang_args=()
    [ -n "$ACTIVE_LANGUAGE" ] && lang_args=(--language "$ACTIVE_LANGUAGE")

    local -a extra_args=()
    [ -n "$EXTRA_STREAM_ARGS" ] && read -ra extra_args <<< "$EXTRA_STREAM_ARGS"

    local stderr_log
    stderr_log="$RUNTIME_DIR/whisper-dictation-$(id -u).stderr"
    local lang_label="${ACTIVE_LANGUAGE^^}"

    # Show loading OSD — use cached backend or fixed-width placeholder
    osd "loading [$lang_label] [${BACKEND:-------}]" true

    "$STREAM_BIN" \
        --model "$MODEL_PATH" \
        --step 0 \
        --threads "$THREADS" \
        --length "$STREAM_LENGTH" \
        --vad-thold "$VAD_THRESHOLD" \
        --freq-thold "$FREQ_THRESHOLD" \
        --no-fallback \
        "${lang_args[@]}" \
        "${extra_args[@]}" \
        > "$FIFO" 2>"$stderr_log" &
    STREAM_PID=$!

    parse_and_type &
    READER_PID=$!

    # Detect backend once, then cache it for future loading screens
    if [ -z "$BACKEND" ]; then
        local backend="unknown"
        for (( _i = 0; _i < 100; _i++ )); do
            kill -0 "$STREAM_PID" 2>/dev/null || break
            local _log
            _log=$(< "$stderr_log") 2>/dev/null || true
            if [[ "${_log,,}" == *"vulkan"* ]]; then
                backend="Vulkan"; break
            elif [[ "${_log,,}" == *"cpu"* ]]; then
                backend="CPU"; break
            fi
            sleep 0.1
        done
        # Pad to width of longest backend ("unknown" = 7) so brackets stay fixed
        printf -v BACKEND '%-7s' "$backend"
        osd "loading [$lang_label] [$BACKEND]" true
        sleep 1
    fi

    osd "* REC * [$lang_label]" true
}

do_stop() {
    [ -z "$STREAM_PID" ] && return

    { kill "$STREAM_PID" 2>/dev/null; wait "$STREAM_PID" 2>/dev/null; } || true
    STREAM_PID=""

    # Reader exits naturally when the FIFO write-end closes (stream EOF).
    # Give it up to 0.5 s to finish any in-progress xdotool type before force-killing.
    local i
    for i in 1 2 3 4 5; do
        kill -0 "$READER_PID" 2>/dev/null || break
        sleep 0.1
    done
    { kill "$READER_PID" 2>/dev/null; wait "$READER_PID" 2>/dev/null; } || true
    READER_PID=""

    rm -f "$FIFO"
    osd ""
}

# ── Language commands ──────────────────────────────────────────────────────────

# lang <code>: switch to a specific language, restarting stream if running
do_lang() {
    local code="$1"
    [ -z "$code" ] && return
    local was_running=false
    [ -n "$STREAM_PID" ] && was_running=true
    do_stop
    ACTIVE_LANGUAGE="$code"
    # Keep LANG_INDEX in sync if the language is in the cycle list
    local i
    for i in "${!LANG_LIST[@]}"; do
        if [ "${LANG_LIST[$i]}" = "$code" ]; then
            LANG_INDEX=$i
            break
        fi
    done
    $was_running && do_start
}

# cycle: off → lang[0] → lang[1] → … → lang[N] → off → …
do_cycle() {
    local next=$(( LANG_INDEX + 1 ))
    if [ "$next" -ge "${#LANG_LIST[@]}" ]; then
        do_stop
        LANG_INDEX=-1
    else
        LANG_INDEX=$next
        ACTIVE_LANGUAGE="${LANG_LIST[$LANG_INDEX]}"
        do_stop
        do_start
    fi
}

# ── Cleanup ────────────────────────────────────────────────────────────────────

cleanup() {
    do_stop
    rm -f "$SOCKET" "$FIFO"
    exit 0
}

trap cleanup SIGTERM SIGINT

# ── Model loading indicator ───────────────────────────────────────────────────

echo "whisper-daemon starting, model=$WHISPER_MODEL languages=$WHISPER_LANGUAGES" >&2

# ── Socket server ──────────────────────────────────────────────────────────────

rm -f "$SOCKET" "$FIFO"

# Start recording immediately — daemon is launched on first keypress
LANG_INDEX=0
ACTIVE_LANGUAGE="${LANG_LIST[0]}"
do_start

while true; do
    cmd=$(socat -T5 UNIX-LISTEN:"$SOCKET",mode=0600 STDOUT 2>/dev/null) || true
    # Strip trailing newline, then trim leading/trailing whitespace
    cmd="${cmd%%$'\n'*}"
    cmd="${cmd#"${cmd%%[![:space:]]*}"}"
    cmd="${cmd%"${cmd##*[![:space:]]}"}"
    case "$cmd" in
        start)     do_start ;;
        stop)      do_stop  ;;
        cycle)     do_cycle ;;
        "lang "*)  do_lang "${cmd#lang }" ;;
    esac

    # Watchdog: if stream died unexpectedly while recording, restart it
    if [ -n "$STREAM_PID" ] && ! kill -0 "$STREAM_PID" 2>/dev/null; then
        echo "whisper-stream exited unexpectedly (exit $?), restarting..." >&2
        osd "stream crashed, restarting..." false
        wait "$STREAM_PID" 2>/dev/null || true
        STREAM_PID=""
        if [ -n "$READER_PID" ]; then
            sleep 0.2
            { kill "$READER_PID" 2>/dev/null; wait "$READER_PID" 2>/dev/null; } || true
            READER_PID=""
        fi
        rm -f "$FIFO"
        sleep 1
        do_start
    fi
done
